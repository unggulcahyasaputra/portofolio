---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const experiences = await getCollection('experiences');
const sortedExperiences = experiences.sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime());
---

<Layout title="Experience">
  <section class="py-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h1 class="section-heading">Professional Experience</h1>
        <p class="section-subheading mx-auto">
          A timeline of my journey across different organizations and roles.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="relative">
          <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-dark-border"></div>

          <div class="space-y-12">
            {sortedExperiences.map((experience, index) => (
              <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                <div class="absolute left-4 md:left-1/2 w-4 h-4 rounded-full bg-primary-600 dark:bg-primary-500 transform -translate-x-1/2 mt-6 border-4 border-white dark:border-dark-bg"></div>

                <div class="md:w-1/2 pl-12 md:pl-0">
                  <div class={`card ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'}`}>
                    <div class="flex items-start justify-between mb-4">
                      <div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white">{experience.data.title}</h3>
                        <p class="text-primary-600 dark:text-primary-400 font-medium">{experience.data.organization}</p>
                      </div>
                      {experience.data.current && (
                        <span class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs px-2 py-1 rounded-full font-medium">
                          Current
                        </span>
                      )}
                    </div>

                    <div class="flex flex-wrap gap-2 mb-4">
                      {experience.data.skills.map(skill => (
                        <span class="tag text-xs">{skill}</span>
                      ))}
                    </div>

                    <p class="text-gray-600 dark:text-gray-400 mb-4">{experience.data.description}</p>

                    <div class="flex items-center text-sm text-gray-500 dark:text-gray-500">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {new Date(experience.data.startDate).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' })}
                      {experience.data.current ? ' - Present' : ` - ${experience.data.endDate && new Date(experience.data.endDate).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' })}`}
                      {experience.data.location && ` • ${experience.data.location}`}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>