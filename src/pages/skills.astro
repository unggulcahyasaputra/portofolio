---
import Layout from '../layouts/Layout.astro';

const skillCategories = [
  {
    name: "Cybersecurity",
    icon: "shield",
    description: "Protecting digital assets and building security awareness",
    skills: ["Security Auditing", "Penetration Testing", "Incident Response", "Security Awareness", "Risk Assessment", "Compliance"]
  },
  {
    name: "AI & Machine Learning",
    icon: "cpu",
    description: "Building intelligent systems and leveraging AI for innovation",
    skills: ["Machine Learning", "Natural Language Processing", "Computer Vision", "AI Ethics", "Data Analysis", "Model Training"]
  },
  {
    name: "Full-Stack Development",
    icon: "code",
    description: "Building modern web and mobile applications",
    skills: ["React", "Node.js", "TypeScript", "Python", "PostgreSQL", "GraphQL", "REST APIs", "Cloud Infrastructure"]
  },
  {
    name: "Healthcare IT",
    icon: "heart",
    description: "Developing solutions for healthcare and medical systems",
    skills: ["Health Information Systems", "HL7/FHIR", "Hospital Management", "Telemedicine", "Medical Data Security", "HIPAA Compliance"]
  },
  {
    name: "Open Source Systems",
    icon: "globe",
    description: "Building and contributing to open-source solutions",
    skills: ["Community Leadership", "Open Source Contribution", "System Architecture", "Documentation", "Peer Review", "Package Development"]
  },
  {
    name: "Digital Transformation",
    icon: "trending-up",
    description: "Helping organizations modernize and innovate",
    skills: ["Strategy Planning", "Process Optimization", "Change Management", "Stakeholder Engagement", "Technology Adoption", "Innovation Management"]
  }
];
---

<Layout title="Skills">
  <section class="py-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h1 class="section-heading">Skills & Expertise</h1>
        <p class="section-subheading mx-auto">
          Core competencies spanning technology, security, and business transformation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillCategories.map(category => (
          <div class="card">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-3 bg-primary-100 dark:bg-primary-900/30 rounded-lg">
                {category.icon === 'shield' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {category.icon === 'cpu' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                )}
                {category.icon === 'code' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {category.icon === 'heart' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                )}
                {category.icon === 'globe' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {category.icon === 'trending-up' && (
                  <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                )}
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">{category.name}</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">{category.description}</p>
            <div class="flex flex-wrap gap-2">
              {category.skills.map(skill => (
                <span class="tag text-xs">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>