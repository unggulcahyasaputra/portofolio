---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const ventures = await getCollection('ventures');
const sortedVentures = ventures.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));

const categories = [...new Set(ventures.map(v => v.data.category))];
---

<Layout title="Ventures">
  <section class="py-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h1 class="section-heading">Ventures & Projects</h1>
        <p class="section-subheading mx-auto">
          Building innovative solutions across technology, security, education, and transportation sectors.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedVentures.map(venture => (
          <div class="card group">
            <div class="flex items-start justify-between mb-4">
              <div>
                <span class="text-xs font-medium text-primary-600 dark:text-primary-400 uppercase tracking-wider">
                  {venture.data.category}
                </span>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mt-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {venture.data.name}
                </h3>
              </div>
              {venture.data.featured && (
                <span class="bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 text-xs px-2 py-1 rounded-full font-medium">
                  Featured
                </span>
              )}
            </div>

            <p class="text-gray-600 dark:text-gray-400 mb-6">{venture.data.description}</p>

            <div class="flex flex-wrap gap-2 mb-6">
              {venture.data.technologies.map(tech => (
                <span class="tag text-xs">{tech}</span>
              ))}
            </div>

            {venture.data.website && (
              <a
                href={venture.data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline"
              >
                Visit Website
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50 dark:bg-dark-card/50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Explore by Category</h2>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {categories.map(category => (
          <a
            href={`#${category.toLowerCase().replace(/\s+/g, '-')}`}
            class="px-6 py-3 bg-white dark:bg-dark-card rounded-lg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>